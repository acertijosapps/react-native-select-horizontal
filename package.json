{
  "name": "@acertijosapps/react-native-select-horizontal",
  "version": "1.0.4",
  "description": "A sleek, mobile-first alternative to the traditional dropdown for React Native. Instead of opening a menu, users step through options inline with left/right arrows — optimized for touch, dependency-free and fully themeable (colors, fonts, sizes and custom icons).",
  "keywords": [
    "react-native",
    "select",
    "horizontal",
    "stepper",
    "picker",
    "selector",
    "carousel",
    "dropdown",
    "items",
    "combo box",
    "menu",
    "android",
    "ios"
  ],
  "homepage": "https://acertijosapps.com/librerias/react-native-select-horizontal",
  "author": "AcertijosApps <acertijos.contacto@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acertijosapps/react-native-select-horizontal.git"
  },
  "bugs": {
    "url": "https://github.com/acertijosapps/react-native-select-horizontal/issues"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.tsx",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && yarn build:cjs && yarn build:module && yarn build:types",
    "build:cjs": "tsc --project tsconfig.build.json --module commonjs --outDir lib/commonjs --declaration false",
    "build:module": "tsc --project tsconfig.build.json --module esnext --outDir lib/module --declaration false",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepare": "yarn build",
    "clean": "rm -rf lib",
    "prepublishOnly": "yarn typecheck && yarn lint && yarn format:check"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.64.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.73.0",
    "@types/react": "^18.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^2.8.8",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
