{
  "name": "@acertijosapps/react-native-select-horizontal",
  "version": "1.0.0",
  "description": "A dependency-free horizontal stepper/selector for React Native. Navigate a list of options with left/right arrows. Fully themeable via props: colors, fonts, sizes and custom arrow icons.",
  "keywords": [
    "react-native",
    "select",
    "horizontal",
    "stepper",
    "picker",
    "selector",
    "carousel"
  ],
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn build:cjs && yarn build:module && yarn build:types",
    "build:cjs": "tsc --project tsconfig.build.json --module commonjs --outDir lib/commonjs",
    "build:module": "tsc --project tsconfig.build.json --module esnext --outDir lib/module",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --outDir lib/typescript",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepare": "yarn build",
    "clean": "rm -rf lib"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.64.0"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.73.0",
    "@types/react": "^18.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^2.8.8",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
